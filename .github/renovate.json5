{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
  ],

  "rebaseWhen": "never",

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "enabled": false,
      "matchUpdateTypes": ["digest", "pinDigest", "pin"],
      "matchDepTypes": ["container"],
      "matchFileNames": [".github/workflows/**.yaml", ".github/workflows/**.yml"],
    },
  ],

  // Track the OpenGamingCollective/gamescope `ogc` branch HEAD so we stay in
  // sync with the terra-gamescope RPM shipped by the base image, which pins
  // that same branch by commit. The old bazzite-org/gamescope ba* tag stream
  // is gone (org retired July 2026). CI rebuilds on the PR and surfaces any
  // patch-application breakage.
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^build_files/build-gamescope\\.sh$/"],
      "matchStrings": [
        "GAMESCOPE_BRANCH=\"(?<currentValue>[^\"]+)\"\\s+GAMESCOPE_REF=\"(?<currentDigest>[0-9a-f]{40})\"",
      ],
      "datasourceTemplate": "git-refs",
      "depNameTemplate": "https://github.com/OpenGamingCollective/gamescope",
    },
  ],
}
